# ---------------------------------------------------------------------------
# Variables d'environnement — à renseigner dans Coolify (jamais dans le dépôt).
# Générer les deux premières avec :  npm run hash-password
# ---------------------------------------------------------------------------

# Hash argon2 du mot de passe unique de connexion — mot de passe d'amorçage.
# Une fois l'application en ligne, le mot de passe se change depuis
# « Réglages → Mot de passe » : le nouveau hash est enregistré dans la base
# (volume /data) et l'emporte alors sur cette variable.
#
# ATTENTION — dans un fichier .env, les $ doivent être échappés (\$) : dotenv les
# interprète sinon comme des variables et le hash arrive vide côté application.
# `npm run hash-password` affiche les deux formes : brute pour Coolify, échappée
# pour ce fichier. Exemple :
#   APP_PASSWORD_HASH=\$argon2id\$v=19\$m=19456,t=2,p=1\$AAA...\$BBB...
APP_PASSWORD_HASH=

# Clé de signature du cookie de session — 32 caractères aléatoires minimum.
# En changer déconnecte immédiatement toutes les sessions.
SESSION_SECRET=

# Base SQLite. En production, le fichier doit être dans le volume persistant.
DATABASE_URL=file:/data/app.db

# Fuseau : les jours travaillés sont datés en heure de Paris.
TZ=Europe/Paris

# URL publique de l'application (domaine configuré dans Coolify). Sert aussi à
# décider de l'attribut Secure du cookie de session quand aucun proxy ne pose
# X-Forwarded-Proto.
NEXT_PUBLIC_APP_URL=https://dashboard.mon-domaine.fr
