# ---------------------------------------------------------------------------
# Variables d'environnement — à renseigner dans Coolify (jamais dans le dépôt).
# Générer les deux premières avec :  npm run hash-password
# ---------------------------------------------------------------------------

# Hash argon2 du mot de passe unique de connexion.
APP_PASSWORD_HASH=

# Clé de signature du cookie de session — 32 caractères aléatoires minimum.
# En changer déconnecte immédiatement toutes les sessions.
SESSION_SECRET=

# Base SQLite. En production, le fichier doit être dans le volume persistant.
DATABASE_URL=file:/data/app.db

# Fuseau : les jours travaillés sont datés en heure de Paris.
TZ=Europe/Paris

# URL publique de l'application (domaine configuré dans Coolify).
NEXT_PUBLIC_APP_URL=https://dashboard.mon-domaine.fr
